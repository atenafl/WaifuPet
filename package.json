{
  "name": "waifu-pet",
  "version": "1.0.0",
  "description": "Mascota de escritorio: waifu con orejas y cola de gato",
  "main": "main.js",
  "author": "atenafl",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.atenafl.waifupet",
    "productName": "WaifuPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "pet.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "WaifuPet-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
