{
  "name": "waifu-pet",
  "version": "1.1.0",
  "description": "Mascota de escritorio con IA: waifu tigresa que habla, se mueve y te ayuda con el PC",
  "main": "main.js",
  "author": "atenafl",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.atenafl.waifupet",
    "productName": "WaifuPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "pet.js",
      "preload.js",
      "chat.html",
      "chat.css",
      "chat.js",
      "preload-chat.js",
      "ai/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "mon-sizes.ps1",
        "to": "mon-sizes.ps1"
      },
      {
        "from": "input.ps1",
        "to": "input.ps1"
      },
      {
        "from": "wins.ps1",
        "to": "wins.ps1"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "WaifuPet-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "artifactName": "WaifuPet-${version}.AppImage"
    },
    "electronLanguages": [
      "en-US",
      "es"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
